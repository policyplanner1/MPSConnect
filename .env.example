# Copy to `.env` and set values for your machine / environment.
# Restart Metro after changing: npx react-native start --reset-cache

# Main API (CRM, calculators, etc.)
API_BASE_URL=https://example.com/api/crm/v1

# Login, signup, forgot-password — your Node server `http://<PC-IP>:5000/api/v1`
# Physical device: use PC IPv4 (e.g. 192.168.1.125). Never use localhost on a real phone.
# Android emulator: http://10.0.2.2:5000/api/v1   iOS simulator: http://localhost:5000/api/v1
# If missing, auth falls back to API_BASE_URL (CRM — "route not found" on /auth/*).
AUTH_API_BASE_URL=http:// 192.168.1.171:5000/api/v1

# CRM / service catalogue images (ServiceDetail, etc.) — not explore banners
IMAGE_BASE_URL=https://example.com

# Explore banner images use the same host as AUTH_API_BASE_URL (/uploads/banners/…)

# MPS client OAuth (after login — token stored in AsyncStorage)
MPS_CLIENT_ID=your_mps_client_id
CLIENT_SECRET=your_mps_client_secret
# Optional override (default is derived from API_BASE_URL for /api/crm/v1)
# MPS_OAUTH_TOKEN_URL=https://rewardplanners.com/api/crm/mps/auth/oauth/token
# Service enquiry (default: API_BASE_URL + /mps/service-enquiry → …/api/crm/v1/mps/service-enquiry)
# MPS_SERVICE_ENQUIRY_URL=https://rewardplanners.com/api/crm/mps/service/enquiry
# MPS service cart (GET cart-items, POST add-item)
# MPS_SERVICE_CART_URL=https://rewardplanners.com/api/crm/mps/service/cart
# MPS support tickets (POST create ticket)
# MPS_SUPPORT_TICKETS_URL=https://rewardplanners.com/api/crm/mps/auth/create-ticket
# Numeric CRM user id for enquiry (local login returns a string cuid — CRM needs INTEGER user_id)
CRM_ENQUIRY_USER_ID=1
# Dev only: show service feedback on order details regardless of order status (true / 1)
# FORCE_SERVICE_FEEDBACK=true

# Email (welcome + forgot-password OTP) is sent from backend-api only — set EMAIL_* in backend-api/.env
