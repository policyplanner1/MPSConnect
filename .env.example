# Copy to `.env` and restart Metro: npx react-native start --reset-cache
#
# ─── Production (deployed Node API) ─────────────────────────────────────────
# AUTH_API_BASE_URL=https://mpsconnect.thempstech.com/api/v1
# DOCUMENTS_API_BASE_URL=https://mpsconnect.thempstech.com/api/v1
#
# ─── Local dev (backend-api on your PC) ─────────────────────────────────────
# Physical device: use PC IPv4 — never localhost on a real phone.
# Android emulator: http://10.0.2.2:5000/api/v1
# AUTH_API_BASE_URL=http://192.168.1.169:5000/api/v1
# DOCUMENTS_API_BASE_URL=http://192.168.1.169:5000/api/v1

# CRM catalogue, calculators, service details (Reward Planners)
API_BASE_URL=https://rewardplanners.com/api/crm/v1
IMAGE_BASE_URL=https://rewardplanners.com

# Node API — auth, addresses, DocVault, banners (your deployed server)
AUTH_API_BASE_URL=https://mpsconnect.thempstech.com/api/v1
DOCUMENTS_API_BASE_URL=https://mpsconnect.thempstech.com/api/v1

# MPS client OAuth (same credentials as backend-api/.env)
MPS_CLIENT_ID=your_mps_client_id
CLIENT_SECRET=your_mps_client_secret

# Optional CRM URL overrides (defaults derived from API_BASE_URL)
# MPS_OAUTH_TOKEN_URL=https://rewardplanners.com/api/crm/mps/auth/oauth/token
# MPS_SERVICE_ENQUIRY_URL=https://rewardplanners.com/api/crm/mps/service/enquiry
# MPS_SERVICE_CART_URL=https://rewardplanners.com/api/crm/mps/service/cart
# MPS_SUPPORT_TICKETS_URL=https://rewardplanners.com/api/crm/mps/auth/create-ticket

# Numeric CRM user id when local login returns a string cuid
CRM_ENQUIRY_USER_ID=1

# Dev only: show service feedback on order details regardless of status
# FORCE_SERVICE_FEEDBACK=true
