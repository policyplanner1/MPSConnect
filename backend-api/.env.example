# Copy to backend-api/.env
#
# ─── Production (https://mpsconnect.thempstech.com) ─────────────────────────
# HOST=0.0.0.0
# PORT=5000
# PUBLIC_APP_URL=https://mpsconnect.thempstech.com
# Run migrations on server: npx prisma migrate deploy
#
# ─── Local dev ───────────────────────────────────────────────────────────────
PORT=5000
# Bind on all interfaces so phones on Wi‑Fi can reach the API (required for DocVault upload)
HOST=0.0.0.0
PUBLIC_APP_URL=http://192.168.1.169:5000

DATABASE_URL="mysql://user:password@localhost:3306/mpsconnect"
# Required for login tokens — set a long random string in production
JWT_SECRET=change-me-to-a-long-random-string

# SuperTokens / auth (see existing project setup)
# ...

# MPS CRM OAuth (same client as React Native app — server polls my-orders)
MPS_CLIENT_ID=mps_client_001
MPS_CLIENT_SECRET=your_mps_client_secret
MPS_OAUTH_TOKEN_URL=https://rewardplanners.com/api/crm/mps/auth/oauth/token
MPS_MY_ORDERS_URL=https://rewardplanners.com/api/crm/mps/service/my-orders
# Optional: sync delivery addresses to CRM on save
# MPS_ADDRESSES_URL=https://rewardplanners.com/api/crm/mps/service/addresses

# Firebase Admin — download service account JSON from Firebase Console → Project settings → Service accounts
# Option A: path to JSON file (recommended, do not commit the file)
FIREBASE_SERVICE_ACCOUNT_PATH=./config/firebase-service-account.json
# Option B: entire JSON on one line (escape quotes) — use only if path is not set
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Background job: poll CRM and send FCM when order status changes
ENABLE_ORDER_STATUS_POLL=true
ORDER_STATUS_POLL_INTERVAL_MS=600000

# Real-time push: Reward Planners CRM calls POST /notifications/crm-order-status
CRM_WEBHOOK_SECRET=change-me-to-a-long-random-string

# Email (welcome on signup, OTP on forgot-password) — Gmail: use App Password, quote if it has spaces
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD="your-app-password"
# Optional display/from address (defaults to EMAIL_USER)
# EMAIL_FROM="MPS Connect <your-email@gmail.com>"
# Aliases also supported: SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS, SMTP_FROM